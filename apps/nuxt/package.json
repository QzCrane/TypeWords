{
  "name": "@typewords/nuxt",
  "private": true,
  "scripts": {
    "lexicon:runtime": "node ../../scripts/build-lexicon-runtime.mjs",
    "lexicon:check": "node ../../scripts/build-lexicon-runtime.mjs && node ../../scripts/validate-lexicon.mjs",
    "prestart": "pnpm lexicon:runtime",
    "predev": "pnpm lexicon:runtime",
    "prebuild": "pnpm lexicon:check",
    "predocker-build": "pnpm lexicon:check",
    "prestatic": "pnpm lexicon:check",
    "pregenerate": "pnpm lexicon:check",
    "pregenerate-dev": "pnpm lexicon:check",
    "start": "nuxt dev",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "test": "",
    "docker-build": "nuxt generate",
    "static": "nuxt generate && node scripts/copyDist.js",
    "generate": "nuxt generate && node scripts/do.js && node ../../scripts/deploy-eo-pages.js --dir dist --name type-words-deploy",
    "generate-dev": "nuxt generate && node scripts/do.js && node ../../scripts/deploy-eo-pages.js --dir dist --name dev-typeword",
    "preview": "nuxt preview",
    "i18n:write": "gulp i18nWrite"
  },
  "dependencies": {
    "@typewords/base": "workspace:*",
    "@typewords/libs": "workspace:*",
    "@typewords/core": "workspace:*",
    "@typewords/utils": "workspace:*"
  }
}
